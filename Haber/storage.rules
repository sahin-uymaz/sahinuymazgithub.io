// Firebase Storage Rules
// ADMIN_UID yerine Firebase Authentication'daki admin kullanıcısının UID'sini yazın.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /gundem/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "ADMIN_UID";
    }
  }
}
